{
  "name": "royalty-lab",
  "productName": "Royalty Lab",
  "version": "0.9.8",
  "description": "Учёт роялти лейбла (Primal Rage Lab)",
  "author": "Primal Rage Lab",
  "homepage": "https://github.com/bonddisco-ops/royalty-lab",
  "repository": {
    "type": "git",
    "url": "https://github.com/bonddisco-ops/royalty-lab.git"
  },
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^11.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "exceljs": "^4.4.0",
    "hash-wasm": "^4.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "ru.primalragelab.royaltylab",
    "productName": "Royalty Lab",
    "artifactName": "RoyaltyLab-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "publish": {
      "provider": "github",
      "owner": "bonddisco-ops",
      "repo": "royalty-lab",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "identity": null
    }
  }
}
